# Variáveis de Ambiente - Backend TypeScript

# Porta do servidor
PORT=5000

# URL do frontend (para CORS)
FRONTEND_URL=http://localhost:3000

# Ambiente (development ou production)
NODE_ENV=development

# JWT Secret (ALTERE PARA UM VALOR SEGURO EM PRODUÇÃO!)
JWT_SECRET=sua_chave_secreta_super_segura_aqui_2024

# Tempo de expiração do token JWT
JWT_EXPIRES_IN=8h

# Rounds do bcrypt para hash de senhas (10-12 recomendado)
BCRYPT_ROUNDS=10

# Caminho do banco de dados SQLite
DB_PATH=./database/pizzaria.db

# Credenciais do administrador padrão
ADMIN_EMAIL=admin@pizzaria.com
ADMIN_PASSWORD=Pizzaria@2024
