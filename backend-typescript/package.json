{
  "name": "backend-typescript",
  "version": "1.0.0",
  "description": "Backend do Sistema de Pizzaria em TypeScript",
  "main": "dist/app-server.js",
  "scripts": {
    "build": "tsc",
    "start": "npm run build && node dist/app-server.js",
    "dev": "ts-node-dev --respawn --transpile-only app-server.ts",
    "init-db": "ts-node database/database-init.ts",
    "postinstall": "npm run build"
  },
  "keywords": [
    "pizzaria",
    "backend",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^20.19.25",
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
