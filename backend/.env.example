# Configurações do Servidor
PORT=5000
NODE_ENV=production

# Credenciais do Administrador
ADMIN_EMAIL=admin@pizzaria.com
ADMIN_PASSWORD=Pizzabela2025

# JWT Secret (ALTERE para uma chave única e segura!)
JWT_SECRET=sua_chave_super_secreta_minimo_32_caracteres_aqui

# Configuração do Banco de Dados
DB_PATH=./database/pizzaria.db

# Configurações de CORS (URL do frontend Vercel)
# Pode ser uma URL ou múltiplas separadas por vírgula
CORS_ORIGIN=https://seu-app.vercel.app

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Configurações de Email (para envio de comprovantes)
EMAIL_SERVICE=gmail
EMAIL_USER=seu-email@gmail.com
EMAIL_PASSWORD=sua-senha-de-app-do-gmail
RATE_LIMIT_LOGIN_MAX=5
